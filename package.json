{
  "name": "dsh-custom-wallpaper",
  "version": "1.0.2",
  "type": "module",
  "description": "Import your own picture as the DSH window background, with an adjustable scrim that keeps every panel and label readable.",
  "license": "MIT",
  "author": "识浅",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "background",
    "wallpaper",
    "theme"
  ],
  "homepage": "https://github.com/sqyr7/dsh-custom-background#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqyr7/dsh-custom-background.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
